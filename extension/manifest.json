{
  "manifest_version": 3,
  "name": "Dancing Cats for YouTube",
  "version": "0.5.3",
  "description": "Группа танцующих котов поверх YouTube по карте локального backend.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_title": "Включить или выключить Dancing Cats"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*.json",
        "assets/cats/*/*.json",
        "assets/cats/*/*.webm"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ],
      "use_dynamic_url": true
    }
  ]
}
